#!/bin/bash
# qi-skills pre-push guard v2
#   Rule 1: block any single new/modified file larger than 50MB
#   Rule 2: circuit-break when a single push adds more than 100MB in total
# Tracked template. Install with: bash user_skills/scripts/install_hooks.sh
# Emergency bypass: ALLOW_BIG_PUSH=1 git push ...

set -u

SINGLE_THRESHOLD_MB=50
TOTAL_THRESHOLD_MB=100
SINGLE_THRESHOLD_BYTES=$((SINGLE_THRESHOLD_MB * 1024 * 1024))
TOTAL_THRESHOLD_BYTES=$((TOTAL_THRESHOLD_MB * 1024 * 1024))

if [ "${ALLOW_BIG_PUSH:-0}" = "1" ]; then
  echo "⚠️  pre-push guard bypassed via ALLOW_BIG_PUSH=1"
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$repo_root" || exit 0

tmp_files="$(mktemp)"
sized_files="${tmp_files}.sized"
trap 'rm -f "$tmp_files" "$sized_files"' EXIT

add_paths_from_diff() {
  local range="$1"
  git diff --name-only --diff-filter=AM "$range" 2>/dev/null >> "$tmp_files" || true
}

# Prefer the refs that Git passes to pre-push via stdin.
# Format: <local ref> <local sha1> <remote ref> <remote sha1>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  if [ "${remote_sha:-}" = "0000000000000000000000000000000000000000" ] || [ -z "${remote_sha:-}" ]; then
    git diff-tree --no-commit-id --name-only --diff-filter=AM -r "$local_sha" 2>/dev/null >> "$tmp_files" || true
  else
    add_paths_from_diff "$remote_sha..$local_sha"
  fi
done

# Fallback for direct dry-run/manual execution where stdin may be empty.
if [ ! -s "$tmp_files" ]; then
  if git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
    add_paths_from_diff "@{upstream}..HEAD"
  fi
fi

# Fallback for first push/no upstream or pre-commit verification.
if [ ! -s "$tmp_files" ]; then
  git diff --cached --name-only --diff-filter=AM 2>/dev/null >> "$tmp_files" || true
fi

# Collect "<size_bytes>\t<path>" for every candidate file.
sort -u "$tmp_files" | while IFS= read -r file; do
  [ -z "$file" ] && continue

  size_bytes=""
  if git rev-parse --verify ":$file" >/dev/null 2>&1; then
    size_bytes="$(git cat-file -s ":$file" 2>/dev/null || true)"
  fi
  if [ -z "$size_bytes" ] && [ -f "$file" ]; then
    size_bytes="$(wc -c < "$file" | tr -d ' ')"
  fi
  [ -z "$size_bytes" ] && continue

  printf '%s\t%s\n' "$size_bytes" "$file" >> "$sized_files"
done

[ -s "$sized_files" ] || exit 0

total_bytes="$(awk -F'\t' '{s+=$1} END{printf "%d", s+0}' "$sized_files")"
file_count="$(wc -l < "$sized_files" | tr -d ' ')"
blocked=0

# ---- Rule 1: single oversized file ----
oversized="$(awk -F'\t' -v lim="$SINGLE_THRESHOLD_BYTES" '$1>lim' "$sized_files" | sort -rn)"
if [ -n "$oversized" ]; then
  blocked=1
  echo "❌ pre-push blocked [Rule 1]: single file larger than ${SINGLE_THRESHOLD_MB}MB detected."
  echo ""
  printf '%s\n' "$oversized" | while IFS=$'\t' read -r size file; do
    printf -- '- %s (%.1f MB)\n' "$file" "$(awk -v b="$size" 'BEGIN{print b/1048576}')"
    echo "  fix: git rm --cached \"$file\""
  done
  echo ""
fi

# ---- Rule 2: total payload of this push ----
if [ "$total_bytes" -gt "$TOTAL_THRESHOLD_BYTES" ]; then
  blocked=1
  printf '❌ pre-push blocked [Rule 2]: this push adds %.1f MB in %s files (limit %s MB).\n' \
    "$(awk -v b="$total_bytes" 'BEGIN{print b/1048576}')" "$file_count" "$TOTAL_THRESHOLD_MB"
  echo ""
  echo "Top 10 offenders:"
  sort -rn "$sized_files" | head -10 | while IFS=$'\t' read -r size file; do
    printf -- '- %s (%.1f MB)\n' "$file" "$(awk -v b="$size" 'BEGIN{print b/1048576}')"
  done
  echo ""
  echo "Likely cause: runtime artifacts leaked into Git (.tmp/, snapshots/, output/, downloads/, *.zip, *_export_*.xlsx)."
  echo "fix: check .gitignore, then 'git rm --cached <path>' the generated files."
  echo ""
fi

if [ "$blocked" = "1" ]; then
  echo "Bypass (only if you are sure): ALLOW_BIG_PUSH=1 git push ..."
  exit 1
fi

exit 0
