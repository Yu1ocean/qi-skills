# ==========================================================
# qi-skills 仓库 .gitignore
# 唯一目的：只同步 user_skills/ 下的技能源码，杜绝沙盒垃圾入库
# 2026-08-21 加固：根目录白名单 + 全局临时目录护栏
# ==========================================================

# ---------- 1. 根目录白名单（防止 git add -A 吸入整个沙盒） ----------
/*
!/.gitignore
!/MEMORY.md
!/metadata.json
!/user_skills/
!/tools/
!/published/
!/weekly-card-w30/

# ---------- 2. 通用垃圾 ----------
*.pyc
__pycache__/
.env
*.json
memory/
.aime/
projects/

# 保留 user_skills/ 下的全部技能源码（含 json 配置）
!user_skills/
!user_skills/**

# ---------- 3. 全局临时目录 / 运行时产物护栏（最高优先级，放最后） ----------
.tmp/
**/.tmp/
**/.tmp_*/
**/tmp/
**/.runtime/
**/.cache/
**/.ephemeral_pool/
**/.index/
.heartbeat_dlq*.jsonl

# 快照类
**/snapshots/
**/assets/snapshots/
*.snapshot
*.snapshot.json

# 输出/导出产物
**/output/
**/outputs/
**/downloads/
**/exports/
*_export_*.xlsx
*_export_*.csv
lark_sheet_export_*.xlsx
top3_export_*.xlsx
top3_W*.xlsx
**/weekly-top3-patrol/*.xlsx

# forge 打包产物（zip 一律走飞书云盘，不入 Git）
*.zip

# 媒体大文件
*.mp4
*.mp4.part
*.webm
*.m4a
*.mp3
*.wav
*.ytdl

# 允许保留目录占位文件
!**/.gitkeep

# 根目录必须保留的元数据（覆盖上面的 *.json 全局忽略）
!/metadata.json

# ---------- prism flush 写前快照（本地灾备，永不入库） ----------
tools/backups/
tools/__pycache__/
tools/*.bak
